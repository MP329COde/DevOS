# Local development only. Production credentials come from Vault.
DATABASE_URL="postgresql://devos:change-me@localhost:5432/devos?schema=public"
REDIS_URL="redis://localhost:6379"
VAULT_ADDR="http://localhost:8200"
VAULT_KUBERNETES_AUTH_PATH="kubernetes"
VAULT_KUBERNETES_ROLE="devos-backend"
VAULT_KUBERNETES_JWT_FILE="/var/run/secrets/kubernetes.io/serviceaccount/token"
