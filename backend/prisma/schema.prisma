generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  task
  doc
  goal
  note
  bug
}

enum TaskLevel {
  epic
  story
  task
}

enum ItemLinkType {
  relates_to
  blocks
  is_blocked_by
}

enum DocPageType {
  scanned
  onboarding
}

enum TriageStatus {
  none
  pending
  accepted
  rejected
}

enum BugSeverity {
  low
  medium
  high
  critical
}

/**
 * Statut d'un "Projet de développement" (module Développement, section AM).
 * Distinct de `Item.status` (texte libre) : ce cycle de vie couvre le projet dans son
 * ensemble, pas une tâche individuelle.
 */
enum DevProjectStatus {
  planning
  development
  maintenance
  done
  archived
}

/**
 * État d'une version/release (section AM.6) : de la préparation à la dépréciation.
 */
enum ReleaseState {
  draft
  in_progress
  released
  deprecated
}

/**
 * Type d'environnement de déploiement par projet (section AM.6) — au-delà de dev/staging/prod.
 */
enum EnvironmentKind {
  dev
  staging
  prod
  other
}

/**
 * Statut observé d'un environnement de déploiement.
 */
enum EnvironmentStatus {
  unknown
  up
  down
  degraded
}

/**
 * Fournisseur de DNS dynamique pris en charge pour un `DnsProviderAccount` (module Domaines).
 * `manual` couvre les domaines dont le DNS est géré hors DevOS (pas de mise à jour auto).
 */
enum DnsProviderKind {
  duckdns
  cloudflare
  ovh
  manual
}

/**
 * Cycle de vie observé d'un `Domain` (module Domaines).
 */
enum DomainState {
  active
  pending
  error
  expired
  disabled
}

/**
 * État d'un `Certificate` ACME. `expiring` est dérivé de `expiresAt` à la lecture
 * (moins de 30 jours), jamais persisté.
 */
enum CertificateState {
  none
  pending
  valid
  expiring
  expired
  error
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Item {
  id                   String              @id @default(uuid()) @db.Uuid
  type                 ItemType
  taskLevel            TaskLevel?          @map("task_level")
  title                String              @db.VarChar(300)
  description          String?             @db.Text
  content              String?             @db.Text
  status               String              @default("backlog") @db.VarChar(50)
  required             Boolean             @default(false)
  dueAt                DateTime?           @map("due_at")
  triage               TriageStatus        @default(none)
  mergeRequestState    String?             @map("merge_request_state") @db.VarChar(20)
  pipelineStatus       String?             @map("pipeline_status") @db.VarChar(20)
  coderTemplateId      String?             @map("coder_template_id") @db.VarChar(100)
  coderWorkspaceId     String?             @map("coder_workspace_id") @db.VarChar(100)
  coderWorkspaceName   String?             @map("coder_workspace_name") @db.VarChar(200)
  coderWorkspaceStatus String?             @map("coder_workspace_status") @db.VarChar(30)
  cycleId              String?             @map("cycle_id") @db.Uuid
  cycle                Cycle?              @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  devProjectId         String?             @map("dev_project_id") @db.Uuid
  devProject           DevProject?         @relation(fields: [devProjectId], references: [id], onDelete: SetNull)
  releaseId            String?             @map("release_id") @db.Uuid
  release              Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  timeEntries          TimeEntry[]
  gitlabLinks          GitLabIssueLink[]
  comments             ItemComment[]
  parentId             String?             @map("parent_id") @db.Uuid
  parent               Item?               @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             Item[]              @relation("ItemHierarchy")
  labels               ItemLabel[]
  outgoingLinks        ItemLink[]          @relation("ItemLinkSource")
  incomingLinks        ItemLink[]          @relation("ItemLinkTarget")
  docLinks             DocLink[]
  attachments          ItemAttachment[]
  codeReferences       ItemCodeReference[]
  timelineEvents       TimelineEvent[]
  domains              Domain[]
  severity             BugSeverity?        @map("severity")
  environment          String?             @db.VarChar(100)
  versionAffected      String?             @map("version_affected") @db.VarChar(100)
  expectedBehavior     String?             @map("expected_behavior") @db.Text
  observedBehavior     String?             @map("observed_behavior") @db.Text
  reproSteps           String?             @map("repro_steps") @db.Text
  logs                 String?             @db.Text
  screenshots          String[]            @default([])
  releaseRef           String?             @map("release_ref") @db.VarChar(200)
  commitRef            String?             @map("commit_ref") @db.VarChar(200)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([parentId])
  @@index([cycleId])
  @@index([devProjectId])
  @@index([releaseId])
  @@map("items")
}

/**
 * Entité "Projet de développement" (module Développement, section AM du TODO).
 * Fondation partagée par toutes les sous-vagues AM.2 à AM.8 : dépôts, tâches/bugs,
 * roadmap/versions/environnements, CI-CD/déploiements/qualité/sécurité, doc/architecture/membres.
 * Reste volontairement simple ici (pas de vrai système d'auth) : `owner`/`members` sont du texte
 * libre, à faire évoluer plus tard vers de vraies relations utilisateur (section AC).
 */
model DevProject {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @db.VarChar(200)
  description    String?               @db.Text
  status         DevProjectStatus      @default(planning)
  owner          String?               @db.VarChar(200)
  members        String[]              @default([])
  plannedStartAt DateTime?             @map("planned_start_at")
  plannedEndAt   DateTime?             @map("planned_end_at")
  deliveryGoal   String?               @map("delivery_goal") @db.Text
  /// Gabarit à partir duquel ce projet a été créé (assistant de création, AM.2) ; null pour un
  /// projet vierge ou créé avant l'ajout de cette relation. `onDelete: SetNull` : supprimer un
  /// template du catalogue ne doit jamais casser les projets déjà créés à partir de lui.
  templateId     String?               @map("template_id") @db.Uuid
  template       DevTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items          Item[]
  releases       Release[]
  environments   Environment[]
  permissions    ProjectPermission[]
  timelineEvents TimelineEvent[]
  cicdConfigs    DevProjectCiCdConfig[]
  resources      ProjectResource[]
  catalogEntities CatalogEntity[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([templateId])
  @@map("dev_projects")
}

enum CiCdProvider {
  gitlab
  github
}

/**
 * Liaison d'un DevProject à un de ses dépôts CI/CD réels (AM.7). Un projet peut désormais avoir
 * plusieurs dépôts liés (ex: backend/frontend/infra), chacun avec un `role` texte libre — d'où
 * l'unicité déplacée sur (devProjectId, provider, repoIdentifier) plutôt que sur devProjectId
 * seul. Le token n'est jamais stocké en clair en base : seul un nom de secret Vault
 * (`vaultSecretName`) y est persisté, la valeur elle-même vit dans Vault KV2 via le même
 * mécanisme que SecretsService (backend/src/tasks/secrets-service.ts), sous un mount dédié
 * `devos-cicd-tokens` distinct des secrets applicatifs génériques.
 */
model DevProjectCiCdConfig {
  id              String       @id @default(uuid()) @db.Uuid
  devProjectId    String       @map("dev_project_id") @db.Uuid
  devProject      DevProject   @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  provider        CiCdProvider
  /// Rôle libre du dépôt dans le projet (ex: "backend", "frontend", "infra", "autre")
  role            String       @db.VarChar(50)
  /// Nom lisible du dépôt, distinct de `repoIdentifier` (ex: pour l'affichage frontend)
  name            String?      @db.VarChar(200)
  /// GitLab : project ID (ex "12345" ou "groupe/projet") ; GitHub : "owner/repo"
  repoIdentifier  String       @map("repo_identifier") @db.VarChar(300)
  webUrl          String?      @map("web_url") @db.VarChar(500)
  defaultBranch   String?      @map("default_branch") @db.VarChar(100)
  /// Nom de la clé Vault KV2 sous le mount `devos-cicd-tokens` (jamais la valeur elle-même)
  vaultSecretName String       @map("vault_secret_name") @db.VarChar(150)
  argoAppName     String?      @map("argo_app_name") @db.VarChar(200)
  harborProject   String?      @map("harbor_project") @db.VarChar(200)
  harborRepo      String?      @map("harbor_repo") @db.VarChar(200)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([devProjectId, provider, repoIdentifier])
  @@index([devProjectId])
  @@map("dev_project_cicd_configs")
}

/**
 * Ressource externe rattachée à un DevProject à titre indicatif (AM.7+) : base de données,
 * cache, bucket... Volontairement simple (texte libre pour `type`/`host`/`note`) : pas de
 * connexion réelle ni de credentials, juste un aide-mémoire pour l'équipe (le stockage de
 * secrets réels reste le rôle de SecretsService/Vault).
 */
model ProjectResource {
  id           String     @id @default(uuid()) @db.Uuid
  devProjectId String     @map("dev_project_id") @db.Uuid
  devProject   DevProject @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(200)
  type         String     @db.VarChar(50)
  host         String?    @db.VarChar(300)
  note         String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([devProjectId])
  @@map("project_resources")
}

/**
 * Version/release d'un `DevProject` (section AM.6). Le changelog est généré automatiquement à
 * la publication à partir des `Item` associés (titres des tâches/bugs livrés dans cette
 * version) puis figé en texte, plutôt qu'une relation many-to-many à recalculer sans fin.
 */
model Release {
  id             String          @id @default(uuid()) @db.Uuid
  devProjectId   String          @map("dev_project_id") @db.Uuid
  devProject     DevProject      @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  version        String          @db.VarChar(50)
  name           String?         @db.VarChar(200)
  description    String?         @db.Text
  state          ReleaseState    @default(draft)
  plannedAt      DateTime?       @map("planned_at")
  releasedAt     DateTime?       @map("released_at")
  changelog      String?         @db.Text
  items          Item[]
  timelineEvents TimelineEvent[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([devProjectId, version])
  @@index([devProjectId, state])
  @@map("releases")
}

/**
 * Environnement de déploiement par projet (dev/staging/prod/autre — section AM.6). Le statut,
 * la version déployée et le pipeline sont mis à jour par les intégrations CI/CD (AM.7) ; les
 * actions sensibles (déploiement en prod notamment) exigent une confirmation explicite côté API,
 * même pattern que les actions Proxmox (section Q).
 */
model Environment {
  id               String            @id @default(uuid()) @db.Uuid
  devProjectId     String            @map("dev_project_id") @db.Uuid
  devProject       DevProject        @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  name             String            @db.VarChar(100)
  kind             EnvironmentKind   @default(other)
  url              String?           @db.VarChar(500)
  status           EnvironmentStatus @default(unknown)
  currentVersion   String?           @map("current_version") @db.VarChar(50)
  expectedVersion  String?           @map("expected_version") @db.VarChar(50)
  pipelineStatus   String?           @map("pipeline_status") @db.VarChar(30)
  lastDeployedAt   DateTime?         @map("last_deployed_at")
  lastError        String?           @map("last_error") @db.Text
  requiresApproval Boolean           @default(false) @map("requires_approval")
  timelineEvents   TimelineEvent[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([devProjectId, name])
  @@index([devProjectId, kind])
  @@map("environments")
}

model Cycle {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime  @map("ends_at")
  closedAt  DateTime? @map("closed_at")
  items     Item[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("cycles")
}

model AutomationRule {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  enabled   Boolean  @default(true)
  trigger   String   @db.VarChar(80)
  condition Json?
  action    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, trigger])
  @@map("automation_rules")
}

model TimeEntry {
  id        String    @id @default(uuid()) @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, startedAt])
  @@map("time_entries")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String   @map("entity_id") @db.VarChar(100)
  action          String   @db.VarChar(50)
  decision        String   @db.VarChar(20)
  localUpdatedAt  DateTime @map("local_updated_at")
  remoteUpdatedAt DateTime @map("remote_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

/**
 * Événement unifié de la timeline d'audit/historique globale (commit, pipeline, tests, image
 * publiée, scan sécurité, manifest modifié, sync ArgoCD, déploiement en bonne santé, publication
 * de release, mise à jour plateforme, activité item...). Remplace la reconstruction ad-hoc de
 * `DevActivityService.timeline()` (item/commentaire uniquement) par une vraie table d'évènements,
 * chacun pouvant être relié à un utilisateur, un projet, une tâche, une release, un environnement,
 * un commit et un pipeline — pour afficher une seule chronologie plutôt qu'un historique par outil.
 * `type`/`status` restent du texte libre (comme `Environment.pipelineStatus`) pour ne pas figer un
 * enum à chaque nouvel outil CI/CD branché.
 */
model TimelineEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String       @db.VarChar(40)
  status        String?      @db.VarChar(20)
  summary       String       @db.VarChar(500)
  actorEmail    String?      @map("actor_email") @db.VarChar(320)
  actorName     String?      @map("actor_name") @db.VarChar(200)
  devProjectId  String?      @map("dev_project_id") @db.Uuid
  devProject    DevProject?  @relation(fields: [devProjectId], references: [id], onDelete: SetNull)
  itemId        String?      @map("item_id") @db.Uuid
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  releaseId     String?      @map("release_id") @db.Uuid
  release       Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  environmentId String?      @map("environment_id") @db.Uuid
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  commitRef     String?      @map("commit_ref") @db.VarChar(200)
  pipelineRef   String?      @map("pipeline_ref") @db.VarChar(200)
  version       String?      @db.VarChar(50)
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([devProjectId, createdAt])
  @@index([itemId])
  @@index([releaseId])
  @@index([environmentId])
  @@index([type, createdAt])
  @@map("timeline_events")
}

model DocPage {
  id            String      @id @default(uuid()) @db.Uuid
  sourceProject String      @map("source_project") @db.VarChar(200)
  path          String      @db.VarChar(500)
  title         String      @db.VarChar(300)
  content       String      @db.Text
  pageType      DocPageType @default(scanned) @map("page_type")
  links         DocLink[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([sourceProject, path])
  @@map("doc_pages")
}

model DocLink {
  id        String   @id @default(uuid()) @db.Uuid
  docPageId String   @map("doc_page_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  docPage   DocPage  @relation(fields: [docPageId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([docPageId, itemId])
  @@map("doc_links")
}

model CatalogEntity {
  id            String      @id @default(uuid()) @db.Uuid
  kind          String      @db.VarChar(50)
  name          String      @db.VarChar(200)
  sourceProject String      @map("source_project") @db.VarChar(200)
  description   String?     @db.Text
  type          String      @db.VarChar(50)
  lifecycle     String      @db.VarChar(50)
  owner         String      @db.VarChar(200)
  system        String?     @db.VarChar(100)
  dependsOn     String[]    @map("depends_on")
  providesApis  String[]    @map("provides_apis")
  annotations   Json
  links         Json
  /// Rattachement optionnel au DevProject dont cette entité est issue (AM.7+) ; `SetNull` à la
  /// suppression du projet pour ne jamais perdre l'entrée de catalogue elle-même.
  devProjectId  String?     @map("dev_project_id") @db.Uuid
  devProject    DevProject? @relation(fields: [devProjectId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([kind, name])
  @@index([devProjectId])
  @@map("catalog_entities")
}

model HAProxyChangeLog {
  id         String    @id @default(uuid()) @db.Uuid
  action     String    @db.VarChar(20)
  backend    String    @db.VarChar(100)
  server     Json
  createdAt  DateTime  @default(now()) @map("created_at")
  revertedAt DateTime? @map("reverted_at")

  @@index([backend])
  @@map("haproxy_change_logs")
}

/**
 * Compte chez un fournisseur de DNS dynamique (module Domaines). Plusieurs comptes du même
 * `kind` (ex: plusieurs comptes DuckDNS) peuvent coexister sans se perturber : chaque `Domain`
 * référence explicitement le compte qui gère son enregistrement. Le token/API key n'est jamais
 * stocké ici, seulement son nom dans Vault (`vaultSecretName`), suivant le pattern de
 * `SecretsService`/`VaultClient`.
 */
model DnsProviderAccount {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(150)
  kind            DnsProviderKind
  vaultSecretName String          @map("vault_secret_name") @db.VarChar(200)
  config          Json?
  domains         Domain[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([kind, name])
  @@map("dns_provider_accounts")
}

/**
 * Compte ACME (ex: Let's Encrypt) utilisé pour émettre des `Certificate`. La clé de compte
 * privée n'est jamais stockée ici, seulement son nom dans Vault (`vaultSecretName`).
 */
model AcmeAccount {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(150)
  directoryUrl    String        @map("directory_url") @db.VarChar(300)
  contactEmail    String        @map("contact_email") @db.VarChar(200)
  vaultSecretName String        @map("vault_secret_name") @db.VarChar(200)
  certificates    Certificate[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([name])
  @@map("acme_accounts")
}

/**
 * Entité "Domaine" (module Domaines) : nom, DNS, cible, état, certificat, site associé. Le
 * chemin HAProxy (frontend → ACL → backend → serveur) n'est volontairement pas dupliqué ici :
 * il est résolu à la demande depuis la config HAProxy réelle via `HAProxyClient` et
 * `resolveDomainHAProxyLink` (`backend/src/catalog/domain-haproxy-link.ts`). `haproxyFrontend`
 * n'est qu'un dernier mapping connu pour affichage rapide, pas la source de vérité.
 */
model Domain {
  id              String              @id @default(uuid()) @db.Uuid
  name            String              @db.VarChar(255)
  target          String?             @db.VarChar(255)
  state           DomainState         @default(pending)
  dnsProviderId   String?             @map("dns_provider_id") @db.Uuid
  dnsProvider     DnsProviderAccount? @relation(fields: [dnsProviderId], references: [id], onDelete: SetNull)
  haproxyFrontend String?             @map("haproxy_frontend") @db.VarChar(100)
  siteItemId      String?             @map("site_item_id") @db.Uuid
  siteItem        Item?               @relation(fields: [siteItemId], references: [id], onDelete: SetNull)
  certificates    Certificate[]
  lastCheckedAt   DateTime?           @map("last_checked_at")
  lastError       String?             @map("last_error") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([name])
  @@index([dnsProviderId])
  @@index([siteItemId])
  @@index([state])
  @@map("domains")
}

/**
 * Certificat ACME émis (ou à émettre) pour un `Domain`. Le certificat et sa clé privée
 * n'est jamais stocké ici, seulement son nom dans Vault (`vaultSecretName`). `haproxyStorageName`
 * référence l'entrée correspondante dans le storage `ssl_certificates` de la Data Plane API
 * HAProxy une fois poussée.
 */
model Certificate {
  id                 String           @id @default(uuid()) @db.Uuid
  domainId           String           @map("domain_id") @db.Uuid
  domain             Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  acmeAccountId      String           @map("acme_account_id") @db.Uuid
  acmeAccount        AcmeAccount      @relation(fields: [acmeAccountId], references: [id], onDelete: Restrict)
  state              CertificateState @default(none)
  vaultSecretName    String           @map("vault_secret_name") @db.VarChar(200)
  haproxyStorageName String?          @map("haproxy_storage_name") @db.VarChar(150)
  issuedAt           DateTime?        @map("issued_at")
  expiresAt          DateTime?        @map("expires_at")
  lastError          String?          @map("last_error") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([domainId])
  @@index([acmeAccountId])
  @@index([expiresAt])
  @@map("certificates")
}

model GitLabIssueLink {
  id              String   @id @default(uuid()) @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  gitlabProjectId String   @map("gitlab_project_id") @db.VarChar(100)
  issueIid        Int      @map("issue_iid")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([gitlabProjectId, issueIid])
  @@unique([itemId, gitlabProjectId])
  @@map("gitlab_issue_links")
}

model ItemComment {
  id                 String   @id @default(uuid()) @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  body               String   @db.Text
  author             String?  @db.VarChar(200)
  propagatedToGitlab Boolean  @default(false) @map("propagated_to_gitlab")
  createdAt          DateTime @default(now()) @map("created_at")
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("item_comments")
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  prefix    String      @db.VarChar(50)
  value     String      @db.VarChar(100)
  items     ItemLabel[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([prefix, value])
  @@map("labels")
}

model ItemLabel {
  itemId  String @map("item_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([itemId, labelId])
  @@map("item_labels")
}

model ItemLink {
  sourceId String       @map("source_id") @db.Uuid
  targetId String       @map("target_id") @db.Uuid
  type     ItemLinkType
  source   Item         @relation("ItemLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Item         @relation("ItemLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId, type])
  @@index([targetId])
  @@map("item_links")
}

/**
 * Catalogue de templates du module Développement (section AM.3 de TODO-refonte-2.md) : gabarits
 * réutilisables pour la création guidée de projet (AM.2), distincts des entités `CatalogEntity`
 * de type "template" du Catalogue applicatif (Backstage-like, section AD) qui décrivent des
 * services déjà existants plutôt que des gabarits de génération.
 * Versionnement : éditer un template en place met à jour la ligne existante ; publier une
 * nouvelle version crée une nouvelle ligne avec `previousVersionId` pointant vers l'ancienne,
 * conservant l'historique. `isDefault` désigne le template proposé par défaut dans l'assistant de
 * création de projet (un seul actif à la fois, appliqué au niveau service). `active=false`
 * désactive un template pour la création de nouveaux projets sans le supprimer (les projets déjà
 * créés à partir de lui restent inchangés).
 */
model DevTemplate {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(200)
  type              String       @map("type") @db.VarChar(50)
  description       String?      @db.Text
  technologies      String[]     @map("technologies")
  dependencies      Json         @default("[]") @map("dependencies")
  version           String       @default("1.0.0") @db.VarChar(50)
  environments      String[]     @map("environments")
  integrableTools   String[]     @map("integrable_tools")
  generatedItems    String[]     @map("generated_items")
  isDefault         Boolean      @default(false) @map("is_default")
  active            Boolean      @default(true)
  previousVersionId String?      @map("previous_version_id") @db.Uuid
  /// "custom" (créé dans DevOS) ou "community" (importé d'un registre/dépôt public, ex. npm create-*).
  source            String       @default("custom") @db.VarChar(20)
  /// Registre du gabarit communautaire, ex. "npm", "github". Null pour les templates "custom".
  registry          String?      @db.VarChar(20)
  /// Identifiant à référencer côté projet créé : nom de paquet npm (ex. "create-vite") pour
  /// registry="npm", ou "org/repo" pour registry="github".
  packageName       String?      @map("package_name") @db.VarChar(300)
  /// URL du dépôt source du gabarit communautaire (affichage + lien direct), optionnelle.
  repositoryUrl     String?      @map("repository_url") @db.VarChar(500)
  projects          DevProject[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([active])
  @@index([source, type])
  @@map("dev_templates")
}

/**
 * Pièce jointe libre sur un item (AM.5) : capture, log, fichier de repro... Stockée comme
 * référence (URL/chemin), jamais le binaire en base — cohérent avec le reste du schéma (pas de
 * BLOB en Postgres ici).
 */
model ItemAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(300)
  url       String   @db.Text
  mimeType  String?  @map("mime_type") @db.VarChar(120)
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_attachments")
}

/**
 * Référence de code liée à un item (AM.5) : commit, merge/pull request ou version/release.
 * Complète les champs `mergeRequestState`/`pipelineStatus` déjà sur `Item` (qui reflètent l'état
 * de LA MR courante) en permettant plusieurs références horodatées (historique).
 */
model ItemCodeReference {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  refType   String   @map("ref_type") @db.VarChar(20) // commit | merge_request | release
  label     String   @db.VarChar(200)
  url       String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, refType])
  @@map("item_code_references")
}

/**
 * Workflow de statuts configurable (AM.5) : remplace l'idée d'un statut figé unique pour tous les
 * items. `scope` référence `DevProject.id` (texte libre, pas de FK stricte pour rester utilisable
 * avant/sans projet — ex. workflow global) ; `scope = null` définit le workflow par défaut utilisé
 * quand un projet n'a pas configuré le sien.
 */
model WorkflowStatus {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String?  @db.VarChar(100)
  key       String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  color     String?  @db.VarChar(20)
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  isFinal   Boolean  @default(false) @map("is_final")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([scope, order])
  @@map("workflow_statuses")
}

/**
 * Modèle "Bug" distinct des tâches (AM.5) : un item générique ne porte pas de gravité,
 * environnement, version affectée, comportement attendu/observé, étapes de reproduction ou logs.
 * `itemId` relie optionnellement le bug à un item de suivi (ex. tâche de correction) sans
 * dupliquer son cycle de vie ; `devProjectId` rattache le bug à un projet une fois AM.1 en place.
 */
enum AvailabilityStatus {
  available
  busy
  away
  do_not_disturb
  vacation
  offline
}

/**
 * Section AC (TODO-refonte-2.md) : profil utilisateur DevOS, résolu par identité réelle. `email`
 * relie ce profil au compte Keycloak authentifié : `auth/session-role.ts` retrouve ce
 * `UserProfile` à partir de l'email porté par la session Keycloak (cookie `devos_session`) pour
 * déterminer `role` (rôle global) et l'appartenance aux projets via `ProjectPermission`.
 */
model UserProfile {
  id                        String              @id @default(uuid()) @db.Uuid
  email                     String              @unique @db.VarChar(320)
  displayName               String              @map("display_name") @db.VarChar(150)
  avatarEmoji               String?             @map("avatar_emoji") @db.VarChar(16)
  avatarColor               String?             @map("avatar_color") @db.VarChar(20)
  avatarImageUrl            String?             @map("avatar_image_url") @db.VarChar(500)
  statusEmoji               String?             @map("status_emoji") @db.VarChar(16)
  statusMessage             String?             @map("status_message") @db.VarChar(200)
  availability              AvailabilityStatus  @default(available)
  availabilityFrom          DateTime?           @map("availability_from")
  availabilityUntil         DateTime?           @map("availability_until")
  shortName                 String?             @map("short_name") @db.VarChar(40)
  availabilityScheduleStart String?             @map("availability_schedule_start") @db.VarChar(5)
  availabilityScheduleEnd   String?             @map("availability_schedule_end") @db.VarChar(5)
  themeMode                 String?             @map("theme_mode") @db.VarChar(20)
  themeColors               Json?               @map("theme_colors")
  profileBackground         String?             @map("profile_background") @db.VarChar(40)
  notificationPreferences   Json?               @map("notification_preferences")
  roleId                    String?             @map("role_id") @db.Uuid
  role                      Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  projectPermissions        ProjectPermission[]
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@map("user_profiles")
}

/**
 * Rôle configurable (section AC), au-delà des trois rôles historiques câblés en dur dans
 * `auth/permissions.ts` (Admin/Contributeur/Lecteur). `permissions` reprend le même vocabulaire
 * d'actions (`Action` dans permissions.ts) sous forme de tableau JSON, pour rester lisible/éditable
 * depuis l'UI sans migration à chaque nouveau rôle métier (ex. Réseau, Testeur). `isSystem`
 * protège les trois rôles historiques d'une suppression accidentelle.
 */
model Role {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique @db.VarChar(100)
  description        String?             @db.Text
  color              String?             @db.VarChar(20)
  icon               String?             @db.VarChar(40)
  permissions        String[]            @default([])
  isSystem           Boolean             @default(false) @map("is_system")
  profiles           UserProfile[]
  projectPermissions ProjectPermission[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("roles")
}

/**
 * Accès d'un profil à un `DevProject` donné, avec un rôle qui peut différer du rôle global du
 * profil (ex. Lecteur global mais Contributeur sur un projet précis). Section AC.
 */
/**
 * Notification persistée pour le centre de notifications (icône cloche). `readAt` marque la
 * lecture ; `deletedAt` retire l'entrée du centre sans purger la ligne, pour conserver un
 * historique consultable/auditable 60 jours après création (voir `purgeExpired` dans
 * NotificationsService) avant suppression définitive.
 */
model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(300)
  message      String    @db.Text
  category     String?   @db.VarChar(50)
  resourceKind String?   @map("resource_kind") @db.VarChar(30)
  resourceId   String?   @map("resource_id") @db.VarChar(120)
  priority     String    @default("normal") @db.VarChar(20)
  readAt       DateTime? @map("read_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([deletedAt, createdAt])
  @@map("notifications")
}

model ProjectPermission {
  id            String      @id @default(uuid()) @db.Uuid
  devProjectId  String      @map("dev_project_id") @db.Uuid
  devProject    DevProject  @relation(fields: [devProjectId], references: [id], onDelete: Cascade)
  userProfileId String      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  roleId        String      @map("role_id") @db.Uuid
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([devProjectId, userProfileId])
  @@index([devProjectId])
  @@index([userProfileId])
  @@map("project_permissions")
}
