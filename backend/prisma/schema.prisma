generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  task
  doc
  goal
  note
}

enum TaskLevel {
  epic
  story
  task
}

enum ItemLinkType {
  relates_to
  blocks
  is_blocked_by
}

enum DocPageType {
  scanned
  onboarding
}

enum TriageStatus {
  none
  pending
  accepted
  rejected
}

enum BugSeverity {
  low
  medium
  high
  critical
}

/**
 * Statut d'un "Projet de développement" (module Développement, section AM).
 * Distinct de `Item.status` (texte libre) : ce cycle de vie couvre le projet dans son
 * ensemble, pas une tâche individuelle.
 */
enum DevProjectStatus {
  planning
  development
  maintenance
  done
  archived
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Item {
  id          String    @id @default(uuid()) @db.Uuid
  type        ItemType
  taskLevel   TaskLevel? @map("task_level")
  title       String    @db.VarChar(300)
  description String?   @db.Text
  content     String?   @db.Text
  status      String    @default("backlog") @db.VarChar(50)
  required    Boolean   @default(false)
  dueAt       DateTime? @map("due_at")
  triage      TriageStatus @default(none)
  mergeRequestState String? @map("merge_request_state") @db.VarChar(20)
  pipelineStatus String? @map("pipeline_status") @db.VarChar(20)
  coderTemplateId   String? @map("coder_template_id") @db.VarChar(100)
  coderWorkspaceId  String? @map("coder_workspace_id") @db.VarChar(100)
  coderWorkspaceName String? @map("coder_workspace_name") @db.VarChar(200)
  coderWorkspaceStatus String? @map("coder_workspace_status") @db.VarChar(30)
  cycleId     String?   @db.Uuid @map("cycle_id")
  cycle       Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  devProjectId String?  @db.Uuid @map("dev_project_id")
  devProject  DevProject? @relation(fields: [devProjectId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  gitlabLinks GitLabIssueLink[]
  comments    ItemComment[]
  parentId    String?   @db.Uuid @map("parent_id")
  parent      Item?     @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Item[]    @relation("ItemHierarchy")
  labels      ItemLabel[]
  outgoingLinks ItemLink[] @relation("ItemLinkSource")
  incomingLinks ItemLink[] @relation("ItemLinkTarget")
  docLinks    DocLink[]
  attachments ItemAttachment[]
  codeReferences ItemCodeReference[]
  bugs        Bug[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([parentId])
  @@index([cycleId])
  @@index([devProjectId])
  @@map("items")
}

/**
 * Entité "Projet de développement" (module Développement, section AM du TODO).
 * Fondation partagée par toutes les sous-vagues AM.2 à AM.8 : dépôts, tâches/bugs,
 * roadmap/versions/environnements, CI-CD/déploiements/qualité/sécurité, doc/architecture/membres.
 * Reste volontairement simple ici (pas de vrai système d'auth) : `owner`/`members` sont du texte
 * libre, à faire évoluer plus tard vers de vraies relations utilisateur (section AC).
 */
model DevProject {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(200)
  description     String?           @db.Text
  status          DevProjectStatus  @default(planning)
  owner           String?           @db.VarChar(200)
  members         String[]          @default([])
  plannedStartAt  DateTime?         @map("planned_start_at")
  plannedEndAt    DateTime?         @map("planned_end_at")
  deliveryGoal    String?           @db.Text @map("delivery_goal")
  items           Item[]
  bugs            Bug[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("dev_projects")
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  closedAt  DateTime? @map("closed_at")
  items     Item[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("cycles")
}

model AutomationRule {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  enabled   Boolean  @default(true)
  trigger   String   @db.VarChar(80)
  condition Json?
  action    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, trigger])
  @@map("automation_rules")
}

model TimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid @map("item_id")
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, startedAt])
  @@map("time_entries")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  entityType       String   @db.VarChar(50) @map("entity_type")
  entityId         String   @db.VarChar(100) @map("entity_id")
  action           String   @db.VarChar(50)
  decision         String   @db.VarChar(20)
  localUpdatedAt   DateTime @map("local_updated_at")
  remoteUpdatedAt  DateTime @map("remote_updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model DocPage {
  id            String      @id @default(uuid()) @db.Uuid
  sourceProject String      @db.VarChar(200) @map("source_project")
  path          String      @db.VarChar(500)
  title         String      @db.VarChar(300)
  content       String      @db.Text
  pageType      DocPageType @default(scanned) @map("page_type")
  links         DocLink[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([sourceProject, path])
  @@map("doc_pages")
}

model DocLink {
  id        String   @id @default(uuid()) @db.Uuid
  docPageId String   @db.Uuid @map("doc_page_id")
  itemId    String   @db.Uuid @map("item_id")
  docPage   DocPage  @relation(fields: [docPageId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([docPageId, itemId])
  @@map("doc_links")
}

model CatalogEntity {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String   @db.VarChar(50)
  name          String   @db.VarChar(200)
  sourceProject String   @db.VarChar(200) @map("source_project")
  description   String?  @db.Text
  type          String   @db.VarChar(50)
  lifecycle     String   @db.VarChar(50)
  owner         String   @db.VarChar(200)
  system        String?  @db.VarChar(100)
  dependsOn     String[] @map("depends_on")
  providesApis  String[] @map("provides_apis")
  annotations   Json
  links         Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([kind, name])
  @@map("catalog_entities")
}

model HAProxyChangeLog {
  id         String    @id @default(uuid()) @db.Uuid
  action     String    @db.VarChar(20)
  backend    String    @db.VarChar(100)
  server     Json
  createdAt  DateTime  @default(now()) @map("created_at")
  revertedAt DateTime? @map("reverted_at")

  @@index([backend])
  @@map("haproxy_change_logs")
}

model GitLabIssueLink {
  id              String   @id @default(uuid()) @db.Uuid
  itemId          String   @db.Uuid @map("item_id")
  gitlabProjectId String   @db.VarChar(100) @map("gitlab_project_id")
  issueIid        Int      @map("issue_iid")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([gitlabProjectId, issueIid])
  @@unique([itemId, gitlabProjectId])
  @@map("gitlab_issue_links")
}

model ItemComment {
  id                 String   @id @default(uuid()) @db.Uuid
  itemId             String   @db.Uuid @map("item_id")
  body               String   @db.Text
  author             String?  @db.VarChar(200)
  propagatedToGitlab Boolean  @default(false) @map("propagated_to_gitlab")
  createdAt          DateTime @default(now()) @map("created_at")
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("item_comments")
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  prefix    String      @db.VarChar(50)
  value     String      @db.VarChar(100)
  items     ItemLabel[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([prefix, value])
  @@map("labels")
}

model ItemLabel {
  itemId  String @db.Uuid @map("item_id")
  labelId String @db.Uuid @map("label_id")
  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([itemId, labelId])
  @@map("item_labels")
}

model ItemLink {
  sourceId String       @db.Uuid @map("source_id")
  targetId String       @db.Uuid @map("target_id")
  type     ItemLinkType
  source   Item        @relation("ItemLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Item        @relation("ItemLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId, type])
  @@index([targetId])
  @@map("item_links")
}

/**
 * Catalogue de templates du module Développement (section AM.3 de TODO-refonte-2.md) : gabarits
 * réutilisables pour la création guidée de projet (AM.2), distincts des entités `CatalogEntity`
 * de type "template" du Catalogue applicatif (Backstage-like, section AD) qui décrivent des
 * services déjà existants plutôt que des gabarits de génération.
 *
 * Versionnement : éditer un template en place met à jour la ligne existante ; publier une
 * nouvelle version crée une nouvelle ligne avec `previousVersionId` pointant vers l'ancienne,
 * conservant l'historique. `isDefault` désigne le template proposé par défaut dans l'assistant de
 * création de projet (un seul actif à la fois, appliqué au niveau service). `active=false`
 * désactive un template pour la création de nouveaux projets sans le supprimer (les projets déjà
 * créés à partir de lui restent inchangés).
 */
model DevTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(200)
  type              String   @db.VarChar(50) @map("type")
  description       String?  @db.Text
  technologies      String[] @map("technologies")
  dependencies      Json     @default("[]") @map("dependencies")
  version           String   @default("1.0.0") @db.VarChar(50)
  environments      String[] @map("environments")
  integrableTools   String[] @map("integrable_tools")
  generatedItems    String[] @map("generated_items")
  isDefault         Boolean  @default(false) @map("is_default")
  active            Boolean  @default(true)
  previousVersionId String?  @db.Uuid @map("previous_version_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("dev_templates")
}

/**
 * Pièce jointe libre sur un item (AM.5) : capture, log, fichier de repro... Stockée comme
 * référence (URL/chemin), jamais le binaire en base — cohérent avec le reste du schéma (pas de
 * BLOB en Postgres ici).
 */
model ItemAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid @map("item_id")
  fileName  String   @db.VarChar(300) @map("file_name")
  url       String   @db.Text
  mimeType  String?  @db.VarChar(120) @map("mime_type")
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_attachments")
}

/**
 * Référence de code liée à un item (AM.5) : commit, merge/pull request ou version/release.
 * Complète les champs `mergeRequestState`/`pipelineStatus` déjà sur `Item` (qui reflètent l'état
 * de LA MR courante) en permettant plusieurs références horodatées (historique).
 */
model ItemCodeReference {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid @map("item_id")
  refType   String   @db.VarChar(20) @map("ref_type") // commit | merge_request | release
  label     String   @db.VarChar(200)
  url       String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, refType])
  @@map("item_code_references")
}

/**
 * Workflow de statuts configurable (AM.5) : remplace l'idée d'un statut figé unique pour tous les
 * items. `scope` référence `DevProject.id` (texte libre, pas de FK stricte pour rester utilisable
 * avant/sans projet — ex. workflow global) ; `scope = null` définit le workflow par défaut utilisé
 * quand un projet n'a pas configuré le sien.
 */
model WorkflowStatus {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String?  @db.VarChar(100)
  key       String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  color     String?  @db.VarChar(20)
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  isFinal   Boolean  @default(false) @map("is_final")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([scope, order])
  @@map("workflow_statuses")
}

/**
 * Modèle "Bug" distinct des tâches (AM.5) : un item générique ne porte pas de gravité,
 * environnement, version affectée, comportement attendu/observé, étapes de reproduction ou logs.
 * `itemId` relie optionnellement le bug à un item de suivi (ex. tâche de correction) sans
 * dupliquer son cycle de vie ; `devProjectId` rattache le bug à un projet une fois AM.1 en place.
 */
model Bug {
  id                String       @id @default(uuid()) @db.Uuid
  title             String       @db.VarChar(300)
  description       String?      @db.Text
  severity          BugSeverity  @default(medium)
  status            String       @default("open") @db.VarChar(50)
  environment       String?      @db.VarChar(100)
  versionAffected   String?      @db.VarChar(100) @map("version_affected")
  expectedBehavior  String?      @db.Text @map("expected_behavior")
  observedBehavior  String?      @db.Text @map("observed_behavior")
  reproSteps        String?      @db.Text @map("repro_steps")
  logs              String?      @db.Text
  screenshots       String[]     @default([])
  releaseRef        String?      @db.VarChar(200) @map("release_ref")
  commitRef         String?      @db.VarChar(200) @map("commit_ref")
  itemId            String?      @db.Uuid @map("item_id")
  item              Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  devProjectId      String?      @db.Uuid @map("dev_project_id")
  devProject        DevProject?  @relation(fields: [devProjectId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([itemId])
  @@index([devProjectId])
  @@map("bugs")
}
