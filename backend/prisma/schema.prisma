generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  task
  doc
  goal
}

enum TaskLevel {
  epic
  story
  task
}

enum ItemLinkType {
  relates_to
  blocks
  is_blocked_by
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Item {
  id          String    @id @default(uuid()) @db.Uuid
  type        ItemType
  taskLevel   TaskLevel? @map("task_level")
  title       String    @db.VarChar(300)
  description String?   @db.Text
  status      String    @default("backlog") @db.VarChar(50)
  dueAt       DateTime? @map("due_at")
  cycleId     String?   @db.Uuid @map("cycle_id")
  cycle       Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parentId    String?   @db.Uuid @map("parent_id")
  parent      Item?     @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Item[]    @relation("ItemHierarchy")
  labels      ItemLabel[]
  outgoingLinks ItemLink[] @relation("ItemLinkSource")
  incomingLinks ItemLink[] @relation("ItemLinkTarget")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([parentId])
  @@index([cycleId])
  @@map("items")
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  closedAt  DateTime? @map("closed_at")
  items     Item[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("cycles")
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  prefix    String      @db.VarChar(50)
  value     String      @db.VarChar(100)
  items     ItemLabel[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([prefix, value])
  @@map("labels")
}

model ItemLabel {
  itemId  String @db.Uuid @map("item_id")
  labelId String @db.Uuid @map("label_id")
  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([itemId, labelId])
  @@map("item_labels")
}

model ItemLink {
  sourceId String       @db.Uuid @map("source_id")
  targetId String       @db.Uuid @map("target_id")
  type     ItemLinkType
  source   Item        @relation("ItemLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Item        @relation("ItemLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId, type])
  @@index([targetId])
  @@map("item_links")
}
